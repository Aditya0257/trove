# =============================================================================
#  Trove — environment configuration reference (.env.example)
# =============================================================================
#
#  HOW TO USE
#  ----------
#  Spring Boot does NOT read .env automatically. Copy this file to `.env`, fill in
#  real values, and load it into the process one of these ways:
#
#    • Local shell (dev):     set -a; source .env; set +a; then run the jar
#    • Oracle host (systemd): put these in the unit's  EnvironmentFile=/etc/trove.env
#    • Docker / compose:      env_file: [ .env ]
#
#  NEVER commit the real .env (it's git-ignored). Commit only this .example.
#
#  Convention below for every variable:
#    # what it is · why it matters
#    # DEV   → the local docker-compose / Homebrew default
#    # PROD  → what to put for a hosted, free-tier deployment (and where to get it)
#  Anything without a DEV default is REQUIRED in prod.
# =============================================================================


# ── Server ───────────────────────────────────────────────────────────────────
# HTTP port the API listens on.
# DEV  → 8080
# PROD → 8080 behind a reverse proxy (Caddy/Nginx) that terminates HTTPS.
SERVER_PORT=8080

# Log verbosity for com.trove.
# DEV  → INFO   PROD → INFO (DEBUG only when diagnosing)
TROVE_LOG_LEVEL=INFO


# ── Database (Layer 4 index) ─────────────────────────────────────────────────
# Postgres holds the rebuildable index (metadata + extracted text only — never
# blobs). It's a cache: it can be rebuilt from object-storage sidecars.
# DEV  → local Postgres from infra/docker-compose.yml (or Homebrew)
# PROD → Neon free tier (0.5 GB is plenty). Create a project at https://neon.tech,
#        copy the connection string, and split it into the three vars below.
#        Neon requires SSL — keep ?sslmode=require on the URL.
TROVE_DB_URL=jdbc:postgresql://localhost:5432/trove
TROVE_DB_USER=trove
TROVE_DB_PASSWORD=trove
# PROD example:
# TROVE_DB_URL=jdbc:postgresql://ep-cool-name-123456.ap-southeast-1.aws.neon.tech/trove?sslmode=require
# TROVE_DB_USER=trove_owner
# TROVE_DB_PASSWORD=<neon-password>


# ── Object storage (Layer 1 — the source of truth) ───────────────────────────
# Files + one sidecar JSON per file. This is the durable vault. Any S3-compatible
# store works; only endpoint/keys/bucket change (the code is identical — that's the
# whole point of the storage abstraction).
# DEV  → local MinIO from infra/docker-compose.yml
# PROD → Cloudflare R2 free tier (10 GB, zero egress). Create a bucket at
#        dash.cloudflare.com → R2, then an R2 API token (Access Key + Secret).
#        Endpoint is https://<accountid>.r2.cloudflarestorage.com
TROVE_S3_ENDPOINT=http://localhost:9000
TROVE_S3_REGION=us-east-1
TROVE_S3_ACCESS_KEY=minioadmin
TROVE_S3_SECRET_KEY=minioadmin
TROVE_S3_BUCKET=trove
# path-style addressing: required by MinIO, supported by R2 → leave true.
TROVE_S3_PATH_STYLE=true
# Auto-create the bucket on boot (handy in dev). In prod the bucket already exists,
# so this is harmless (set false if the API token lacks CreateBucket permission).
TROVE_S3_AUTO_CREATE_BUCKET=true
# TTL (seconds) for the short-lived signed URLs handed to clients to view files.
TROVE_S3_PRESIGN_TTL=900
# PROD example:
# TROVE_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# TROVE_S3_ACCESS_KEY=<r2-access-key-id>
# TROVE_S3_SECRET_KEY=<r2-secret-access-key>
# TROVE_S3_BUCKET=trove
# TROVE_S3_AUTO_CREATE_BUCKET=false


# ── Second-cloud mirror (Layer 3 — independent copy) ─────────────────────────
# Copies the whole vault to a DIFFERENT provider so one provider outage/account
# loss can't wipe the data. Backblaze B2 is S3-compatible and free (10 GB + 1 GB/day
# egress, permanent — not a trial). Disabled until you set enabled=true + creds.
# PROD → Backblaze B2: create a bucket + an Application Key at backblaze.com.
#        Endpoint looks like https://s3.us-west-004.backblazeb2.com
TROVE_MIRROR_ENABLED=false
TROVE_MIRROR_ENDPOINT=
TROVE_MIRROR_REGION=us-west-004
TROVE_MIRROR_ACCESS_KEY=
TROVE_MIRROR_SECRET_KEY=
TROVE_MIRROR_BUCKET=
TROVE_MIRROR_PATH_STYLE=true
# How often the scheduled mirror runs (ms).
TROVE_MIRROR_SYNC_DELAY_MS=3600000


# ── Google Drive backup (Layer 2 — human-navigable, per space owner) ─────────
# Each space owner connects THEIR OWN Google Drive (free 15 GB, permanent). A
# service account has 0 GB and cannot store files, so per-owner OAuth is required.
# Create an OAuth client (type: Web application) at
# console.cloud.google.com → APIs & Services → Credentials, enable the Google Drive
# API, and add the redirect URI below to the client's Authorized redirect URIs.
# While the OAuth consent screen is in "Testing", add each user as a Test user.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on the OAuth client.
# DEV  → http://localhost:8080/api/integrations/google-drive/callback
# PROD → https://api.yourdomain.com/api/integrations/google-drive/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/google-drive/callback
# How often connected spaces are synced to Drive.
TROVE_DRIVE_SYNC_DELAY_MS=3600000
TROVE_DRIVE_SCHEDULED_SYNC=true


# ── Security: auth + encryption at rest ──────────────────────────────────────
# JWT signing secret (HMAC-SHA256). MUST be long & random in prod (>= 32 bytes).
# Generate: openssl rand -base64 48
TROVE_JWT_SECRET=dev-only-change-me-please-32bytes-minimum-secret
TROVE_JWT_EXPIRATION_MINUTES=720
# Passphrase for encryption at rest (Drive refresh tokens + vital documents). A
# 256-bit AES key is derived from it. MUST be strong in prod, and BACKED UP
# OUT-OF-BAND — if you lose this, vital files become unrecoverable.
# Generate: openssl rand -base64 48
TROVE_ENCRYPTION_KEY=dev-only-change-me-encryption-passphrase


# ── Extraction (who reads the documents) ─────────────────────────────────────
# You choose an ordered CHAIN of providers; the first one that returns a confident
# result wins, the rest are fallbacks. The chain is a LIST, so it's set in
# application.yml (trove.extraction.chain) OR via SPRING_APPLICATION_JSON (below) —
# it can't be a single env var. The per-provider CREDS are the env vars here.
#
# WHICH TO USE:
#   • Hosted deploy (recommended) → Cloudflare Workers AI: free daily quota, nothing
#     to self-host. Set CF_ACCOUNT_ID + CF_API_TOKEN below.
#   • Local dev                   → Ollama (free, on your machine). Not reachable from
#     a cloud host unless you also host Ollama.
#   • Gemini                      → only if your Google account has free quota (many
#     new accounts get 0 — check https://ai.dev/rate-limit).
#   • stub                        → canned output; always keep it LAST as the safety net.
#
# To turn a provider ON, put it in the chain. Easiest for prod (no file edits):
#   SPRING_APPLICATION_JSON='{"trove":{"extraction":{"acceptance-confidence":0.4,
#     "chain":[{"provider":"cloudflare"},{"provider":"stub"}]}}}'

# Cloudflare Workers AI (free, hosted) — dash.cloudflare.com → AI → Workers AI, and
# create an API token with the Workers AI permission. Account id is on the dashboard.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/llava-hf/llava-1.5-7b-hf

# Google Gemini (often 0 free quota — verify first). https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local only). `ollama pull llava` first; point at the host running it.
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llava

# Acceptance threshold (0..1) + circuit breaker for the chain.
TROVE_EXTRACTION_ACCEPT_CONF=0.0
TROVE_EXTRACTION_BREAKER_FAILS=2
TROVE_EXTRACTION_BREAKER_COOLDOWN=300


# ── Natural-language search (optional LLM) ────────────────────────────────────
# OFF by default → a fast rule-based parser handles queries. Turn ON to understand
# richer queries ("top 10 expensive shopping bills") via a TEXT LLM (no vision).
# provider=ollama uses OLLAMA_ENDPOINT + a text model (e.g. llama3); provider=
# cloudflare uses CF_ACCOUNT_ID/CF_API_TOKEN + a text model. Falls back to rules on
# any failure, so it's never worse than off.
TROVE_SEARCH_LLM_ENABLED=false
TROVE_SEARCH_LLM_PROVIDER=ollama
TROVE_SEARCH_LLM_MODEL=llama3
# Async extraction executor sizing (tiny box → keep small).
TROVE_EXTRACTION_CORE_POOL=2
TROVE_EXTRACTION_MAX_POOL=4
TROVE_EXTRACTION_QUEUE=100
# Crash-recovery reconciler sweep (ms) — re-extracts anything left unprocessed.
TROVE_EXTRACTION_RECONCILE_DELAY_MS=300000


# ── Reminders ────────────────────────────────────────────────────────────────
# How often due reminders are dispatched, and how many days before a due date to
# fire the reminder.
TROVE_REMINDER_SCAN_DELAY_MS=3600000
TROVE_REMINDER_LEAD_DAYS=3


# ── Anomaly detection ────────────────────────────────────────────────────────
# Flag a bill above the trailing category average by this fraction (0.40 = 40%),
# over this many months, needing at least this many prior samples.
TROVE_ANOMALY_THRESHOLD=0.40
TROVE_ANOMALY_LOOKBACK_MONTHS=12
TROVE_ANOMALY_MIN_SAMPLES=3


# ── Forward-to-file ingestion (email / WhatsApp webhooks) ────────────────────
# Public webhooks gated by a shared secret; each space also has its own ingest
# token (per-space address). Set a strong secret in prod.
TROVE_INGEST_ENABLED=true
TROVE_INGEST_SECRET=dev-ingest-secret


# ── Database backup (pg_dump) ────────────────────────────────────────────────
# Path to the pg_dump binary (must be reachable from the host).
# DEV (Homebrew) → /opt/homebrew/opt/postgresql@16/bin/pg_dump
# PROD           → pg_dump (if on PATH) or the full path to a v16 client
TROVE_BACKUP_PG_DUMP_PATH=pg_dump
# Run a scheduled nightly dump (uploaded to object storage under backups/).
TROVE_BACKUP_SCHEDULED_DUMP_ENABLED=false


# ── Dev seed (local testing only) ────────────────────────────────────────────
# Flyway V6 seeds one user + personal space with these fixed IDs. On first boot the
# dev user gets this password so you can log in. In PROD set TROVE_DEV_PASSWORD to
# an empty string to DISABLE the dev login (real users register via /api/auth).
TROVE_DEV_USER_ID=00000000-0000-0000-0000-000000000001
TROVE_DEV_SPACE_ID=00000000-0000-0000-0000-000000000010
TROVE_DEV_PASSWORD=devpassword
# PROD → TROVE_DEV_PASSWORD=
