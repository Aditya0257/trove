# Flutter / Dart build artifacts — never committed (regenerated by `flutter pub get`
# and `flutter create .`). Only source (lib/, pubspec.yaml, README, analysis_options)
# is tracked.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
pubspec.lock

# Generated platform folders (run `flutter create .` to regenerate around lib/).
/android/
/ios/
/linux/
/macos/
/windows/
/web/

# IDE / OS
.idea/
*.iml
.DS_Store
.metadata
